  # ════════════════════════════════════════════════════════════
  # PLAYWRIGHT — JS-rendered career pages
  # ════════════════════════════════════════════════════════════

  - name: Amazon
    type: playwright
    url: "https://www.amazon.jobs/en/search?offset=0&result_limit=100&sort=relevant&country%5B%5D=IND"
    selector: ".job-title a"
    link_selector: ".job-title a"
    wait_selector: ".job-title"

  - name: Google
    type: playwright
    url: "https://www.google.com/about/careers/applications/jobs/results?location=India"
    card_selector: ".Ln1EL"
    selector: "h3.QJPWVe"
    link_selector: "a.WpHeLc"
    wait_selector: ".Ln1EL"

  - name: Microsoft
    type: playwright
    url: "https://jobs.careers.microsoft.com/global/en/search?l=India&lc=India&p=1&rt=professional"
    selector: "h2[class*='position-title']"
    wait_selector: "h2[class*='position-title']"

  - name: Goldman Sachs
    type: playwright
    url: "https://higher.gs.com/roles?page=1"
    card_selector: "a[href^='/roles/']"
    selector: "span.gs-uitk-mb-1"
    wait_selector: "a[href^='/roles/']"

  - name: Walmart
    type: playwright
    url: "https://careers.walmart.com/results?q=&page=1&sort=rank&country=IN"
    card_selector: "div[data-testid='job-card']"
    selector: "span[data-testid='job-title']"
    url_attribute: "data-job-id"
    url_template: "https://careers.walmart.com/us/jobs/{}"
    wait_selector: "div[data-testid='job-card']"

  - name: Meta
    type: playwright
    url: "https://www.metacareers.com/jobs"
    card_selector: "a[href*='/profile/job_details/']"
    selector: "h3"
    wait_selector: "a[href*='/profile/job_details/']"

  - name: Adobe
    type: playwright
    url: "https://careers.adobe.com/us/en/search-results?keywords=analyst%20engineer&s=1&rk=l-india"
    selector: ".job-title a, h2.job-title, a[data-ph-at-id='job-link']"
    wait_selector: ".job-title, [data-ph-at-id='job-link']"

  - name: Citi
    type: playwright
    url: "https://jobs.citi.com/search-jobs/India"
    selector: "a.sr-job-item__link"
    wait_selector: "a.sr-job-item__link"

  - name: Barclays
    type: playwright
    url: "https://search.jobs.barclays/search-jobs/India"
    selector: "a.job-title--link"
    wait_selector: "a.job-title--link"

  - name: Rippling
    type: playwright
