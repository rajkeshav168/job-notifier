# ============================================================
# Notifications
# ============================================================

# Notification settings
notifications:
  # Email via SMTP
  email:
    enabled: true
    smtp_host: smtp.gmail.com
    smtp_port: 587
    username: GITHUB_GMAIL_ADDRESS
    password: GITHUB_GMAIL_APP_PASSWORD
    from: GITHUB_GMAIL_ADDRESS
    to:
      - GITHUB_GMAIL_ADDRESS

  # Slack webhook
  slack:
    enabled: false
    webhook_url: https://hooks.slack.com/services/YOUR/WEBHOOK/URL

  # Console output (always on, useful for testing)
  console:
    enabled: true

# How often to check (in minutes) — used in daemon mode
check_interval_minutes: 30

# SQLite database path for tracking seen jobs
db_path: jobs.db
