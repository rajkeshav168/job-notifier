notifications:
  email:
    enabled: true
    smtp_host: smtp.gmail.com
    smtp_port: 587
    username: GITHUB_GMAIL_ADDRESS
    password: GITHUB_GMAIL_APP_PASSWORD
    from: GITHUB_GMAIL_ADDRESS
    to:
      - GITHUB_GMAIL_ADDRESS

  slack:
    enabled: false
    webhook_url: https://hooks.slack.com/services/YOUR/WEBHOOK/URL

  console:
    enabled: true

check_interval_minutes: 30
db_path: jobs.db
